 LIBTARGET    = cmaq
 TARGETDIR    = ./
 $(LIBTARGET) : $(OBJS)
		$(AR) $(ARFLAGS) ../main/libcmaqlib.a $(OBJS)

 include ../configure.wrf

.SUFFIXES: .F .f .c .F90 .f90
.F.o:
	$(FC) -c $(F_FLAGS) $(CPP_FLAGS) $(INCLUDES) $<

.f.o:
	$(FC) -c $(F_FLAGS) $<

.F90.o:
	$(FC) -c $(F90_FLAGS) $(CPP_FLAGS) $(INCLUDES) $<

.f90.o:
	$(FC) -c $(F90_FLAGS) $<

.c.o:
	$(CC) -c $(C_FLAGS) $<

clean:
	rm -f $(OBJS) *.mod


